                "description": "Mobilde i18n anahtarı olarak kullanılır"
              },
              "message": {
                "type": "string",
                "description": "Geliştirici içindir; kullanıcıya gösterilmez"
              },
              "details": {
                "type": "object",
                "propertyNames": {
                  "type": "string"
                },
