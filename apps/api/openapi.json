{
  "openapi": "3.1.0",
  "paths": {
    "/v1/health/live": {
      "get": {
        "description": "Süreç ayakta mı? Bağımlılık kontrol etmez.",
        "operationId": "HealthController_live",
        "parameters": [],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          }
        },
        "summary": "Liveness probe",
        "tags": [
          "health"
        ]
      }
    },
    "/v1/health/ready": {
      "get": {
        "description": "Postgres, Redis ve kuyruk erişimi.",
        "operationId": "HealthController_ready",
        "parameters": [],
        "responses": {
          "200": {
            "description": "The Health Check is successful",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string",
                      "enum": [
                        "ok",
                        "degraded"
                      ],
                      "example": "ok"
                    },
                    "info": {
                      "type": [
                        "object",
                        "null"
                      ],
                      "example": {
                        "database": {
                          "status": "up",
                          "responseTime": 12
                        }
                      },
                      "additionalProperties": {
                        "type": "object",
                        "required": [
                          "status"
                        ],
                        "properties": {
                          "status": {
                            "type": "string",
                            "enum": [
                              "up",
                              "degraded",
                              "down"
                            ]
                          },
                          "responseTime": {
                            "type": "number",
                            "description": "Time the health indicator took to respond, in ms"
                          }
                        },
                        "additionalProperties": true
                      }
                    },
                    "error": {
                      "type": [
                        "object",
                        "null"
                      ],
                      "example": {},
                      "additionalProperties": {
                        "type": "object",
                        "required": [
                          "status"
                        ],
                        "properties": {
                          "status": {
                            "type": "string",
                            "enum": [
                              "up",
                              "degraded",
                              "down"
                            ]
                          },
                          "responseTime": {
                            "type": "number",
                            "description": "Time the health indicator took to respond, in ms"
                          }
                        },
                        "additionalProperties": true
                      }
                    },
                    "details": {
                      "type": "object",
                      "example": {
                        "database": {
                          "status": "up",
                          "responseTime": 12
                        }
                      },
                      "additionalProperties": {
                        "type": "object",
                        "required": [
                          "status"
                        ],
                        "properties": {
                          "status": {
                            "type": "string",
                            "enum": [
                              "up",
                              "degraded",
                              "down"
                            ]
                          },
                          "responseTime": {
                            "type": "number",
                            "description": "Time the health indicator took to respond, in ms"
                          }
                        },
                        "additionalProperties": true
                      }
                    }
                  }
                }
              }
            }
          },
          "503": {
            "description": "Bağımlılıklardan biri erişilemiyor — Olası kodlar: SERVICE_UNAVAILABLE\n\nThe Health Check is not successful",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string",
                      "enum": [
                        "error",
                        "shutting_down"
                      ],
                      "example": "error"
                    },
                    "info": {
                      "type": [
                        "object",
                        "null"
                      ],
                      "example": {
                        "database": {
                          "status": "up",
                          "responseTime": 12
                        }
                      },
                      "additionalProperties": {
                        "type": "object",
                        "required": [
                          "status"
                        ],
                        "properties": {
                          "status": {
                            "type": "string",
                            "enum": [
                              "up",
                              "degraded",
                              "down"
                            ]
                          },
                          "responseTime": {
                            "type": "number",
                            "description": "Time the health indicator took to respond, in ms"
                          }
                        },
                        "additionalProperties": true
                      }
                    },
                    "error": {
                      "type": [
                        "object",
                        "null"
                      ],
                      "example": {
                        "redis": {
                          "status": "down",
                          "message": "Could not connect",
                          "responseTime": 3005
                        }
                      },
                      "additionalProperties": {
                        "type": "object",
                        "required": [
                          "status"
                        ],
                        "properties": {
                          "status": {
                            "type": "string",
                            "enum": [
                              "up",
                              "degraded",
                              "down"
                            ]
                          },
                          "responseTime": {
                            "type": "number",
                            "description": "Time the health indicator took to respond, in ms"
                          }
                        },
                        "additionalProperties": true
                      }
                    },
                    "details": {
                      "type": "object",
                      "example": {
                        "database": {
                          "status": "up",
                          "responseTime": 12
                        },
                        "redis": {
                          "status": "down",
                          "message": "Could not connect",
                          "responseTime": 3005
                        }
                      },
                      "additionalProperties": {
                        "type": "object",
                        "required": [
                          "status"
                        ],
                        "properties": {
                          "status": {
                            "type": "string",
                            "enum": [
                              "up",
                              "degraded",
                              "down"
                            ]
                          },
                          "responseTime": {
                            "type": "number",
                            "description": "Time the health indicator took to respond, in ms"
                          }
                        },
                        "additionalProperties": true
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "summary": "Readiness probe",
        "tags": [
          "health"
        ]
      }
    }
  },
  "info": {
    "title": "Kabx API",
    "description": "Kabx dijital gardırop ve stil uygulaması API dokümanı.\n\nHata cevapları her zaman `ErrorResponse` formatındadır; `error.code` mobil tarafta\ni18n anahtarı olarak kullanılır. Listeler cursor tabanlı sayfalama kullanır.",
    "version": "1.0.0",
    "contact": {}
  },
  "tags": [],
