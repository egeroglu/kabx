  "info": {
    "title": "Kabx API",
    "description": "Kabx dijital gardırop ve stil uygulaması API dokümanı.\n\nHata cevapları her zaman `ErrorResponse` formatındadır; `error.code` mobil tarafta\ni18n anahtarı olarak kullanılır. Listeler cursor tabanlı sayfalama kullanır.",
    "version": "1.0.0",
    "contact": {}
  },
  "tags": [],
  "servers": [
    {
      "url": "/",
      "description": "Geçerli sunucu"
    }
  ],
  "components": {
    "securitySchemes": {
      "bearer": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http",
        "description": "Kısa ömürlü access token"
      }
    },
    "schemas": {
      "AppleSignInInput": {
        "type": "object",
        "properties": {
          "idToken": {
            "type": "string",
            "minLength": 16,
            "maxLength": 8192,
            "description": "Sign in with Apple identity token (JWT)"
          },
          "displayName": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1,
                "maxLength": 80
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "idToken"
        ],
        "additionalProperties": false
      },
      "AuthResult": {
        "type": "object",
        "properties": {
          "session": {
            "type": "object",
            "properties": {
              "accessToken": {
                "type": "string"
              },
              "expiresIn": {
                "type": "integer",
                "minimum": -9007199254740991,
                "maximum": 9007199254740991
              },
              "refreshToken": {
                "type": "string"
              },
              "refreshTokenExpiresAt": {
                "type": "string",
                "format": "date-time",
                "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
              }
            },
            "required": [
              "accessToken",
              "expiresIn",
              "refreshToken",
              "refreshTokenExpiresAt"
            ],
            "additionalProperties": false
          },
          "userId": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          },
          "isNewUser": {
            "type": "boolean",
            "description": "true ise istemci onboarding akışına gider"
          },
          "onboardingCompleted": {
            "type": "boolean"
          }
        },
        "required": [
          "session",
          "userId",
          "isNewUser",
          "onboardingCompleted"
        ],
        "additionalProperties": false
      },
