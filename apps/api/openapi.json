                  "UPLOAD_BATCH_TOO_LARGE",
                  "WARDROBE_ITEM_NOT_FOUND",
                  "WARDROBE_ITEM_NOT_READY",
                  "AI_QUOTA_EXCEEDED",
                  "AI_TAGGING_FAILED",
                  "OUTFIT_NOT_FOUND",
                  "OUTFIT_SLOTS_INVALID",
                  "WEATHER_UNAVAILABLE",
                  "LOCATION_REQUIRED",
                  "DISCOVERY_CARD_NOT_FOUND",
                  "QUIZ_SET_NOT_FOUND",
                  "QUIZ_NOT_ENOUGH_SWIPES",
                  "WISHLIST_ITEM_NOT_FOUND",
                  "PRODUCT_NOT_FOUND",
                  "LINK_PREVIEW_FAILED",
                  "LINK_NOT_ALLOWED"
