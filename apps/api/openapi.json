                  "INTERNAL_ERROR",
                  "VALIDATION_FAILED",
                  "NOT_FOUND",
                  "METHOD_NOT_ALLOWED",
                  "PAYLOAD_TOO_LARGE",
                  "RATE_LIMITED",
                  "SERVICE_UNAVAILABLE",
                  "INVALID_CURSOR",
                  "IDEMPOTENCY_KEY_REQUIRED",
                  "APP_VERSION_UNSUPPORTED",
                  "UNAUTHORIZED",
                  "FORBIDDEN",
                  "TOKEN_EXPIRED",
                  "REFRESH_TOKEN_INVALID",
                  "REFRESH_TOKEN_REUSED",
                  "OTP_INVALID",
                  "OTP_EXPIRED",
                  "OTP_TOO_MANY_ATTEMPTS",
                  "IDENTITY_PROVIDER_REJECTED",
                  "ACCOUNT_DELETION_IN_PROGRESS",
                  "PREMIUM_REQUIRED",
