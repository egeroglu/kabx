# ─────────────────────────────────────────────────────────────────────────────
# Kabx API — ortam değişkenleri
#
# Kopyala: cp .env.example .env
# Buradaki varsayılanlar `docker compose up` ile gelen yerel servislere işaret
# eder ve HİÇBİR gerçek anahtar gerektirmez: tüm dış servisler `mock` modunda
# çalışır. Gerçek entegrasyon için ilgili *_PROVIDER değerini `live` yap ve
# anahtarı gir. Sırlar repoya commit EDİLMEZ.
# ─────────────────────────────────────────────────────────────────────────────

# --- Çalışma ortamı ---
NODE_ENV=development
API_PORT=3000
API_HOST=0.0.0.0
PUBLIC_API_URL=http://localhost:3000
# Virgülle ayrılmış liste; boş bırakılırsa CORS kapalı (mobil istemci CORS'a tabi değil).
CORS_ORIGINS=
BODY_LIMIT_BYTES=1048576
LOG_LEVEL=debug
LOG_PRETTY=true
OPENAPI_ENABLED=true
DEFAULT_TIMEZONE=Europe/Istanbul

# --- Veritabanı (docker-compose: postgres + pgvector) ---
DATABASE_URL=postgres://kabx:kabx@localhost:55432/kabx
DATABASE_POOL_MAX=10
DATABASE_SSL=false

# --- Redis (cache + BullMQ + rate limit) ---
REDIS_URL=redis://localhost:56379
QUEUE_PREFIX=kabx
WORKER_CONCURRENCY=5

# --- Kimlik doğrulama / oturum (Faz 1) ---
# Production'da mutlaka değiştir; en az 32 karakter.
JWT_ACCESS_SECRET=dev-only-access-secret-change-me-32+chars
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=60
JWT_ISSUER=kabx
JWT_AUDIENCE=kabx-mobile
# Sign in with Apple: Services ID / bundle ID (aud doğrulaması için)
APPLE_CLIENT_ID=
# Google Sign-In OAuth client ID'leri (aud doğrulaması için)
GOOGLE_CLIENT_ID_IOS=
GOOGLE_CLIENT_ID_ANDROID=
OTP_TTL_SECONDS=600
OTP_MAX_ATTEMPTS=5

# --- E-posta (Resend) ---
EMAIL_PROVIDER=mock
RESEND_API_KEY=
EMAIL_FROM=Kabx <no-reply@kabx.app>

# --- Obje depolama (yerelde MinIO, canlıda Cloudflare R2) ---
STORAGE_PROVIDER=mock
S3_ENDPOINT=http://localhost:59000
S3_REGION=auto
S3_BUCKET=kabx-media
S3_ACCESS_KEY_ID=kabxminio
S3_SECRET_ACCESS_KEY=kabxminio
S3_FORCE_PATH_STYLE=true
CDN_BASE_URL=http://localhost:59000/kabx-media
UPLOAD_URL_TTL_SECONDS=900
UPLOAD_MAX_BYTES=10485760

# --- Yapay zekâ (Gemini) ---
# Model adları KODDA SABİT DEĞİL; buradan değiştirilir (BACKEND_SPEC §2).
AI_PROVIDER=mock
GEMINI_API_KEY=
GEMINI_TAGGING_MODEL=gemini-flash-lite-latest
GEMINI_EMBEDDING_MODEL=gemini-embedding-2
EMBEDDING_DIM=768
AI_DAILY_JOB_QUOTA_PER_USER=100
AI_MAX_ATTEMPTS=3

# --- Abonelik (RevenueCat) ---
SUBSCRIPTIONS_PROVIDER=mock
REVENUECAT_API_KEY=
# Webhook Authorization header'ının beklenen değeri (sabit zamanlı karşılaştırılır)
REVENUECAT_WEBHOOK_AUTH=
# HMAC imza doğrulaması açıksa (X-RevenueCat-Webhook-Signature)
REVENUECAT_WEBHOOK_SIGNING_SECRET=
REVENUECAT_ENTITLEMENT=premium

# --- Hava durumu ---
WEATHER_PROVIDER=mock
WEATHER_API_KEY=
WEATHER_API_BASE_URL=https://api.open-meteo.com/v1
WEATHER_CACHE_TTL_SECONDS=3600

# --- Push bildirimi (Expo Push) ---
PUSH_PROVIDER=mock
EXPO_ACCESS_TOKEN=

# --- Gözlemlenebilirlik ---
# DSN boşsa Sentry devre dışı (no-op reporter).
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0
METRICS_ENABLED=true
